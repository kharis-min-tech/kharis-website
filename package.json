{
  "name": "kharis-website",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:main": "npm run dev -w @kharis/main",
    "dev:kp2": "npm run dev -w @kharis/kp2",
    "dev:content": "npm run dev -w @kharis/content",
    "dev:docs": "npm run docs:dev -w @kharis/content",
    "build:main": "npm run build -w @kharis/main",
    "build:kp2": "npm run build -w @kharis/kp2",
    "build:content": "npm run build -w @kharis/content",
    "build:docs": "npm run docs:build -w @kharis/content",
    "deploy:main": "npm run deploy -w @kharis/main",
    "deploy:kp2": "npm run deploy -w @kharis/kp2",
    "deploy:content": "npm run deploy -w @kharis/content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "comments": {
    "overrides.next": "Pin the same patched Next.js release across all apps. OpenNext requires Next.js 16.4.1 or later for preview manifest compatibility."
  },
  "overrides": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "vitest": "^5.1.0"
  }
}
