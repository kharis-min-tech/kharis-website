{
  "name": "kharis-website",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:main": "npm run dev -w @kharis/main",
    "dev:kp2": "npm run dev -w @kharis/kp2",
    "dev:content": "npm run dev -w @kharis/content",
    "build:main": "npm run build -w @kharis/main",
    "build:kp2": "npm run build -w @kharis/kp2",
    "build:content": "npm run build -w @kharis/content",
    "deploy:main": "npm run deploy -w @kharis/main",
    "deploy:kp2": "npm run deploy -w @kharis/kp2",
    "deploy:content": "npm run deploy -w @kharis/content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "vitest": "^5.0.4"
  }
}
