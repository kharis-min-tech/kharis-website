# Public site URL for this workspace. Production host is the subdomain.
NEXT_PUBLIC_SITE_URL=https://content.kharis.org

# Same Supabase project as apps/main and apps/kp2.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Places Text Search + Geocoding for venue pins.
# Enable "Places API" and "Geocoding API" on the key.
GOOGLE_MAPS_API_KEY=

# Server-only. Cloudflare R2 (S3 compatible) for branch images.
# Leave the keys blank here. Set them in .env.local and as Worker secrets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kharis-images
# EU buckets use https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base with no trailing slash, from the bucket's r2.dev or custom domain.
R2_PUBLIC_URL=
