# Public site URL for this workspace. Production host is the subdomain.
NEXT_PUBLIC_SITE_URL=https://content.kharis.org

# Same Supabase project as the other apps.
# Use the new API keys from Dashboard → Settings → API Keys
# (Publishable and secret API keys tab). Legacy anon / service_role JWTs are
# deprecated by end of 2026 — do not add those here.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe. Format: sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Do NOT put sb_secret_... (or legacy service_role) in this app.
# Invites and password resets go through the Kharis API; that backend holds
# SUPABASE_SECRET_KEY=sb_secret_... (server-only).

# Kharis Express API for studio accounts and roles (/v1/studio/*). No trailing slash.
# Add the studio origin to the API's CORS_ORIGINS.
NEXT_PUBLIC_KHARIS_API_URL=

# Server-only. Places Text Search + Geocoding for venue pins.
# Enable "Places API" and "Geocoding API" on the key.
GOOGLE_MAPS_API_KEY=

# Server-only. Cloudflare R2 (S3 compatible) for branch images.
# Leave the keys blank here. Set them in .env.local and as Worker secrets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kharis-images
# EU buckets use https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Server-only. Grace, the studio navigation helper (/api/chat).
# Never use NEXT_PUBLIC_ for this.
GEMINI_API_KEY=

# Public host for branch photos saved by the studio. No trailing slash.
# New uploads store this address instead of the studio origin.
R2_PUBLIC_URL=https://images.kharis.org
