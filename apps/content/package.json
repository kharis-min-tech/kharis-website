{
  "name": "@kharis/content",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "vitepress build docs && next build --webpack",
    "start": "next start --port 3002",
    "lint": "eslint",
    "docs:dev": "vitepress dev docs --port 3004",
    "docs:build": "vitepress build docs",
    "screenshots": "node docs/scripts/capture-screenshots.mjs",
    "screenshots:upload": "node --env-file=../../.env.r2.local docs/scripts/upload-screenshots.mjs --upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10",
    "eslint-config-next": "15.5.27",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "wrangler": "^4.148.0"
  }
}
