{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kharis-content",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  // Required: Supabase clients pull in Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Cutover switch — uncomment to take content.kharis.org/* live on Cloudflare.
  // This app has no basePath: the subdomain is the whole site, unlike
  // kharis.org/kp2 which is a path on the apex zone.
  // Until then `wrangler deploy` only publishes to *.workers.dev and
  // leaves the current production host untouched.
  // "routes": [{ "pattern": "content.kharis.org/*", "zone_name": "kharis.org" }]
}
