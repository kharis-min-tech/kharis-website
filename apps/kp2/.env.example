# Public site URL, used for canonical/OG metadata in lib/seo.ts.
NEXT_PUBLIC_SITE_URL=https://kharis.org/kp2

# Supabase — same project as apps/main; rows are scoped by workspace.
# The publishable key is all that's needed: /api/testimonies inserts via the
# anon role, gated by the "testimonies anon submit" RLS policy (is_published
# forced false). No service-role / secret key required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Public base for branch photos stored as branch-images/... keys.
# Full https URLs from the studio (including R2) work without this.
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.kharis.org

# Server-only. YouTube Data API v3 key for the messages/media pages.
YOUTUBE_API_KEY=

# Server-only. Instagram feed on the home page.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Optional. Google Search Console verification meta tag.
GOOGLE_SITE_VERIFICATION=
