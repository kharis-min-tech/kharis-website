# Public site URL, used for canonical/OG metadata in lib/seo.ts.
NEXT_PUBLIC_SITE_URL=https://kharis.org/kp2

# Supabase — same project as apps/main; rows are scoped by workspace.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by app/api/testimonies to write rows.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. YouTube Data API v3 key for the messages/media pages.
YOUTUBE_API_KEY=

# Server-only. Instagram feed on the home page.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Optional. Google Search Console verification meta tag.
GOOGLE_SITE_VERIFICATION=
