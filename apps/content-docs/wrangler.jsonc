{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kharis-content-docs",
  "compatibility_date": "2026-10-06",
  // A static site: no Worker script, just the VitePress build.
  "assets": {
    "directory": ".vitepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Cutover switch: uncomment to serve the docs at docs.content.kharis.org.
  // Cloudflare creates the DNS record and certificate for a custom domain on
  // deploy, so the API token needs Workers Routes and DNS edit on kharis.org.
  // Until then `wrangler deploy` only publishes to *.workers.dev.
  // "routes": [{ "pattern": "docs.content.kharis.org", "custom_domain": true }],
}
