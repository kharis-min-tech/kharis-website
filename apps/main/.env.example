# Optional. Contact map uses the Maps JavaScript API when this is set.
# Create a key at https://console.cloud.google.com/ with Maps JavaScript API enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase (locations, events, testimonies, contact form)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Public base for branch photos stored as branch-images/... keys.
# Full https URLs from the studio (including R2) work without this.
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.kharis.org
# Server-only. Used by /api/contact and /api/testimonies to write rows.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Loads the full Pastor David message library (uploads playlist) for
# /messages and the Grace chatbot. Without it only ~48 recent/curated messages load.
# Needs a standard Google Cloud API key (starts with "AIza") with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# Server-only. Life page chatbot (/api/chat). Never use NEXT_PUBLIC_ for this.
GEMINI_API_KEY=

# Optional. Where "KP2" links point. Defaults to https://kharis.org/kp2.
NEXT_PUBLIC_KP2_URL=

# Optional. Overrides the hero video when the YouTube lookup fails.
YOUTUBE_HERO_FALLBACK_ID=
