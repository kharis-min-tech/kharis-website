# Optional. Contact map uses the Maps JavaScript API when this is set.
# Create a key at https://console.cloud.google.com/ with Maps JavaScript API enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Kharis API (locations, events, testimonies, contact/visit/quiz forms).
# The site never talks to Supabase directly. Locally: http://localhost:4000
NEXT_PUBLIC_KHARIS_API_URL=
# Optional. Public base for branch photos stored as branch-images/... keys.
# Full https URLs from the studio (including R2) work without this.
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.kharis.org
# Server-only. Loads the full Pastor David message library (uploads playlist) for
# /messages and the Grace chatbot. Without it only ~48 recent/curated messages load.
# Needs a standard Google Cloud API key (starts with "AIza") with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# Server-only. Life page chatbot (/api/chat). Never use NEXT_PUBLIC_ for this.
GEMINI_API_KEY=

# Optional. Where "KP2" links point. Defaults to the current Cloudflare KP2 app.
NEXT_PUBLIC_KP2_URL=

# Optional. Overrides the hero video when the YouTube lookup fails.
YOUTUBE_HERO_FALLBACK_ID=

# --- Email (AWS SES) -------------------------------------------------------
# Branch notifications for the website forms. Sent from the SES-verified
# noreply@kharis.org identity - the same setup kairos and venue-checkin use,
# so the same IAM keys work here.
#
# Leave these BLANK locally and nothing is sent: the route logs the email to
# the console instead and the form still works end to end. In production set
# them as Worker secrets:
#   npx wrangler secret put AWS_ACCESS_KEY_ID
#   npx wrangler secret put AWS_SECRET_ACCESS_KEY
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Non-secret email settings. These are also set in wrangler.jsonc "vars" for
# production; the copies here only apply to local development.
AWS_REGION=eu-west-2
EMAIL_FROM="Kharis Church" <noreply@kharis.org>
SES_CONFIGURATION_SET=kharis-website

# Where a submission goes when the visitor chose no branch. Leave unset and
# those submissions are recorded without an email being sent.
FALLBACK_NOTIFY_EMAIL=

# Cloudflare Turnstile (optional). Without these the forms still work: no
# widget renders and the routes skip verification. The sitekey is public and
# is read at BUILD time; the secret is a Worker secret in production
# (`npx wrangler secret put TURNSTILE_SECRET`).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
